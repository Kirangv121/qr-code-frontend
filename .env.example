# --- Split deploy (frontend and backend on DIFFERENT Vercel projects) ---
# Set this in the FRONTEND Vercel project → Environment Variables → then REDEPLOY
VITE_API_URL=https://qr-code-backend-delta.vercel.app

# Do NOT set VITE_RELATIVE_API when using split deploy

# --- Local dev (Vite proxies /api to port 5000) ---
# Leave VITE_API_URL unset, or use:
# VITE_API_URL=http://localhost:5000
